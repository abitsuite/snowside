---
// apps/web/src/components/Hero.astro
---
<section class="relative pt-32 pb-20 overflow-hidden">
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-[#C8E6F7] via-white to-[#EDE0F0]"></div>
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 leading-tight">
      Snowside<br />
      <span class="text-[#6B2D5B]">The eCash Sidechain on Avalanche</span>
    </h1>
    <p class="mt-6 text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
      Native BTC gas. Instant USDC bridging. Bitcoin‑security, Avalanche speed.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
      <a href="#about" class="rounded-full px-8 py-3 text-sm font-semibold bg-white border border-gray-300 text-gray-800 hover:bg-gray-100 transition">
        Learn More
      </a>
      <a href="#proposal" class="rounded-full px-8 py-3 text-sm font-semibold bg-[#6B2D5B] text-white hover:bg-[#562548] transition">
        Read the Proposal
      </a>
    </div>
  </div>
</section>
