---
// packages/explorer/src/pages/index.astro
import Base from '../layouts/Base.astro';
import ExplorerDashboard from '../components/ExplorerDashboard.astro';

const network = 'mainnet';
const rpcUrl = 'https://rpc.snowside.network/mainnet';
const chainId = 32904;
const title = 'Snowside Explorer - Mainnet';
---
<Base title={title} network={network}>
  <ExplorerDashboard network={network} rpcUrl={rpcUrl} chainId={chainId} />
</Base>
