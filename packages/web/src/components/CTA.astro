---
// packages/web/src/components/CTA.astro
---

<section id="contact" class="py-24 bg-snow-50">
  <div class="max-w-2xl mx-auto px-4 text-center">
    <h2 class="text-3xl font-bold text-slate-900 mb-8">Join the Snowside movement</h2>
    <div class="flex flex-col sm:flex-row justify-center gap-4">
      <a href="/validators" class="rounded-full px-6 py-3 text-sm font-semibold bg-aval-600 text-white hover:bg-aval-700 transition">
        Run a Validator
      </a>
      <a href="https://discord.gg/jVytngEWt" target="_blank" rel="noopener noreferrer" class="rounded-full px-6 py-3 text-sm font-semibold bg-surface-1 border border-white/10 text-white hover:bg-surface-2 transition">
        Join our Discord
      </a>
    </div>
    <p class="mt-6 text-sm">
      <a data-p="pitch" data-s="snowside" data-n="network" onclick="window.open('https://'+this.dataset.p+'.'+this.dataset.s+'.'+this.dataset.n,'_blank');return false;" href="#" rel="nofollow noopener noreferrer" class="text-slate-400 underline decoration-slate-300 hover:text-slate-600 transition">
        View our pitch deck
      </a>
    </p>
  </div>
</section>
