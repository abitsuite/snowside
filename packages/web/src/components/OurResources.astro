---
// packages/web/src/components/OurResources.astro

interface Resource {
  title: string;
  summary: string;
  href: string;
  /** tailwind background classes for the themed card backdrop */
  bg: string;
  /** accent icon path (24x24 stroke icon) */
  icon: string;
  iconColor: string;
}

const resources: Resource[] = [
  {
    title: 'Bridge',
    summary: 'Deposit ECX and bridge USDC across Avalanche and eCash networks.',
    href: 'https://bridge.snowside.network',
    bg: 'bg-gradient-to-br from-[#0a1f3d] via-[#0d2a5c] to-[#11367f]',
    icon: '<path d="M3 8h11M8 3l-5 5 5 5"/><path d="M21 16H10M16 21l5-5-5-5"/>',
    iconColor: '#6bb8e0',
  },
  {
    title: 'Explorer',
    summary: 'Inspect blocks, transactions, and addresses in real time.',
    href: 'https://explorer.snowside.network',
    bg: 'bg-gradient-to-br from-[#0a0f1a] via-[#121826] to-[#1a2335]',
    icon: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>',
    iconColor: '#c8e6f7',
  },
  {
    title: 'Documentation',
    summary: 'Technical guides, architecture references, and integration how-tos.',
    href: 'https://docs.snowside.network',
    bg: 'bg-gradient-to-br from-[#1a2335] via-[#2d5e80] to-[#1f3a5c]',
    icon: '<path d="M4 4h12a3 3 0 013 3v13H7a3 3 0 01-3-3V4z"/><path d="M4 17a3 3 0 013-3h12"/>',
    iconColor: '#e0f0ff',
  },
  {
    title: 'Interactive Tour',
    summary: 'A guided, visual walkthrough of how Snowside works end to end.',
    href: 'https://tour.snowside.network',
    bg: 'bg-gradient-to-br from-[#3d1a3d] via-[#5b2d5b] to-[#2a1140]',
    icon: '<polygon points="6 4 20 12 6 20 6 4"/>',
    iconColor: '#e84142',
  },
  {
    title: 'Lean Canvas',
    summary: 'The one-page Snowside business model canvas and overview.',
    href: 'https://canvas.snowside.network',
    bg: 'bg-gradient-to-br from-[#1f2d1a] via-[#3a5c2d] to-[#1a3520]',
    icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><path d="M4 9h16M4 14h16M10 4v16"/>',
    iconColor: '#a0d0a0',
  },
  {
    title: 'GitHub',
    summary: 'Source code, issue tracker, and open-source contributions.',
    href: 'https://github.com/abitsuite/snowside',
    bg: 'bg-gradient-to-br from-[#0a0f1a] via-[#161b22] to-[#21262d]',
    icon: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 00-1.3-3.2 4.2 4.2 0 00-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 00-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 00-.1 3.2A4.6 4.6 0 004 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
    iconColor: '#c9d1d9',
  },
];
---

<section id="resources" class="py-24 bg-surface-1">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <p class="font-mono text-sm font-semibold text-snow-400 uppercase tracking-widest mb-4">Our Resources</p>
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Everything Snowside, in one place
      </h2>
      <p class="text-slate-400 leading-relaxed">
        Jump straight into the tools, portals, and documentation that make up the Snowside ecosystem.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {resources.map((r) => (
        <a
          href={r.href}
          target="_blank"
          rel="noopener noreferrer"
          class={`group relative overflow-hidden rounded-2xl ${r.bg} p-7 border border-white/10 hover:border-white/30 transition shadow-lg hover:shadow-xl hover:-translate-y-0.5`}
        >
          <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-white/5 blur-2xl group-hover:bg-white/10 transition"></div>
          <div class="relative">
            <div class="w-11 h-11 rounded-xl bg-white/10 backdrop-blur flex items-center justify-center mb-5 border border-white/10">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={r.iconColor} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon} />
            </div>
            <h3 class="text-lg font-semibold text-white mb-2 flex items-center gap-2">
              {r.title}
              <svg class="opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7M7 7h10v10" />
              </svg>
            </h3>
            <p class="text-sm text-slate-300/80 leading-relaxed">{r.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
