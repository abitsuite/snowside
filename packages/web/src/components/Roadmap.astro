---
// packages/web/src/components/Roadmap.astro
---

<section id="roadmap" class="py-24 bg-white">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-gray-900 text-center mb-12">
      From testnet to mainnet
    </h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="py-2 pr-4 font-semibold text-gray-600">Month</th>
            <th class="py-2 font-semibold text-gray-600">Milestone</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-gray-100">
            <td class="py-3 pr-4 font-medium">Month 1</td>
            <td class="py-3">Fuji testnet launch with NodΞRunr template; automated validator setup</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="py-3 pr-4 font-medium">Month 2</td>
            <td class="py-3">Security audit of eCash smart contracts; integration with C‑Chain USDC bridge</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="py-3 pr-4 font-medium">Month 3</td>
            <td class="py-3">Mainnet launch with at least 3 community validators; public RPC and block explorer</td>
          </tr>
          <tr class="border-b border-gray-100">
            <td class="py-3 pr-4 font-medium">Month 4</td>
            <td class="py-3">Community AMA with Paul Sztorc; onboarding documentation released</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-medium">Ongoing</td>
            <td class="py-3">Validator growth, protocol maintenance via NodΞRunr</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
