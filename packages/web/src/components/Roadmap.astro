---
// packages/web/src/components/Roadmap.astro
---

<section id="roadmap" class="py-24 bg-surface-0">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-white text-center mb-12">
      From testnet to mainnet
    </h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-white/10">
            <th class="py-2 pr-4 font-semibold text-slate-400">Month</th>
            <th class="py-2 font-semibold text-slate-400">Milestone</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400">Month 1</td>
            <td class="py-3 text-slate-200">Fuji testnet launch with NodΞRunr template; automated validator setup</td>
          </tr>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400">Month 2</td>
            <td class="py-3 text-slate-200">Security audit of eCash smart contracts; integration with C‑Chain USDC bridge</td>
          </tr>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400">Month 3</td>
            <td class="py-3 text-slate-200">Mainnet launch with at least 3 community validators; public RPC and block explorer</td>
          </tr>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400">Month 4</td>
            <td class="py-3 text-slate-200">Community AMA with Paul Sztorc; onboarding documentation released</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-medium text-snow-400">Ongoing</td>
            <td class="py-3 text-slate-200">Validator growth, protocol maintenance via NodΞRunr</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
