---
// packages/web/src/components/Roadmap.astro
---

<section id="roadmap" class="py-24 bg-surface-0">
  <div class="max-w-3xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-white text-center mb-12">
      From Devnet to Mainnet and Beyond…
    </h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead>
          <tr class="border-b border-white/10">
            <th class="py-2 pr-4 font-semibold text-slate-400">Phase</th>
            <th class="py-2 font-semibold text-slate-400">Milestone</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400 whitespace-nowrap">Devnet</td>
            <td class="py-3 text-slate-200">Local development network; internal testing of eCash.com precompiles, ECX gas, and BMM coordination</td>
          </tr>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400 whitespace-nowrap">Alphanet</td>
            <td class="py-3 text-slate-200">Public alpha with federated bridge; early validator onboarding and deposit flow validation</td>
          </tr>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400 whitespace-nowrap">Betanet</td>
            <td class="py-3 text-slate-200">Permissioned beta; security audit of eCash.com contracts; C‑Chain USDC bridge integration</td>
          </tr>
          <tr class="border-b border-white/5">
            <td class="py-3 pr-4 font-medium text-snow-400 whitespace-nowrap">Mainnet</td>
            <td class="py-3 text-slate-200">Mainnet launch with community validators; public RPC and block explorer live</td>
          </tr>
          <tr>
            <td class="py-3 pr-4 font-medium text-snow-400 whitespace-nowrap">Ongoing</td>
            <td class="py-3 text-slate-200">Validator growth, protocol maintenance, and ecosystem development</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
