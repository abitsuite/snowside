---
// packages/web/src/components/Hero.astro
---

<section class="relative pt-32 pb-20 overflow-hidden bg-surface-0">
  <!-- Gradient background -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-br from-surface-0 via-surface-1 to-surface-0"></div>

  <!-- Subtle grid pattern -->
  <div class="absolute inset-0 -z-10 opacity-[0.02]" style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 48px 48px;"></div>

  <!-- Radial glow accent -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] -z-10 bg-snow-500/10 rounded-full blur-[120px]"></div>

  <div class="relative max-w-4xl mx-auto px-4 text-center">
    <h1 class="font-extrabold text-white leading-tight">
      <span class="text-5xl md:text-7xl">Snowside</span>
      <br />
      <span class="text-4xl md:text-6xl text-snow-400">The eCash Sidechain on Avalanche</span>
    </h1>
    <p class="mt-6 text-lg md:text-xl text-slate-300 max-w-2xl mx-auto">
      Native ECX gas. Instant USDC bridging.<br />
      eCash security, Avalanche speed.
    </p>
    <div class="mt-10 flex flex-col sm:flex-row justify-center gap-4">
      <a href="#about" class="rounded-full px-8 py-4 text-base font-semibold bg-surface-2 border border-white/10 text-slate-200 hover:bg-surface-3 hover:border-white/20 transition">
        Learn More
      </a>
      <a href="https://tour.snowside.network" target="_blank" rel="noopener noreferrer" class="rounded-full px-8 py-4 text-base font-semibold bg-aval-600 text-white hover:bg-aval-700 transition">
        Take a Tour
      </a>
    </div>
  </div>
</section>
