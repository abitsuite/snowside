---
// packages/pitch/src/components/Nav.astro
const links = [
  { label: 'Overview', href: '/#overview' },
  { label: 'How It Works', href: '/#how-it-works' },
  { label: 'Why Avalanche', href: '/#why-avalanche' },
  { label: 'Comparison', href: '/#comparison' },
  { label: 'Roadmap', href: '/#roadmap' },
  { label: 'Team', href: '/#team' },
  { label: 'FAQ', href: '/#faq' },
];
---

<nav class="fixed top-0 z-50 w-full border-b border-white/5 bg-surface-0/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="font-mono text-xl font-bold text-white">
      ❄️ Snowside
    </a>

    <ul class="hidden items-center gap-6 lg:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-slate-300 transition-colors hover:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href="/#cta"
      class="hidden rounded-lg bg-aval-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-aval-700 md:block"
    >
      Read the Proposal
    </a>
  </div>
</nav>
